# Copy this file to .env and fill in your Contentful credentials.
# Used only by scripts/fetch-gallery.mjs (a build-time script), never
# shipped to the browser.

CONTENTFUL_SPACE_ID=
# Content Delivery API (read-only) access token, not the Management API token.
CONTENTFUL_ACCESS_TOKEN=
# Optional, defaults to "master".
CONTENTFUL_ENVIRONMENT=
